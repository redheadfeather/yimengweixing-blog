{
  "name": "@yimengweixing/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --var ENVIRONMENT:development --persist-to ../../.wrangler/state",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run types && npm run typecheck && npm run test && wrangler deploy --dry-run --outdir ../../.wrangler/dry-run",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply yimengweixing-blog --local --persist-to ../../.wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply yimengweixing-blog --remote"
  },
  "dependencies": {
    "@yimengweixing/shared": "0.0.0",
    "hono": "^4.9.9"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.38.0"
  }
}
