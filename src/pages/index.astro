---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, AUTHOR_BIO, SITE_DESCRIPTION } from '../consts';
import { getTagPath } from '../utils/tags';
const posts = (await getCollection('blog')).sort((a,b) => b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const tags = [...new Set(posts.flatMap(p => p.data.tags))];
const featuredPosts = posts.filter((post) => post.data.featured).slice(0, 3);
---
<!doctype html>
<html lang="zh-CN"><head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION}/></head>
<body><Header/><main>
 <section class="intro">
  <div class="intro-copy"><span class="eyebrow">Notes on technology & life</span><h1>把思考写下来，<br/><em>让好奇有回声。</em></h1><p>{AUTHOR_BIO}。记录技术实践，也收集日常生活里的小小发现。</p><a class="button-link" href="/blog/">翻阅所有文章 ↗</a></div>
  <aside class="cover" aria-label="博客介绍"><div class="cover-top"><span>个人札记</span><span>VOL. 01</span></div><div class="cover-art" aria-hidden="true"><span></span><i></i><b>未</b></div><div class="cover-bottom"><strong>一梦未醒</strong><span>技术 · 生活 · 思考</span></div></aside>
 </section>
 {featuredPosts.length > 0 && <section class="featured"><div class="featured-heading"><span class="eyebrow">编辑精选</span><h2>从这里认识我</h2><p>几篇最能代表这个博客的文章：关于技术、建造，以及为什么持续写作。</p></div><div class="featured-list">{featuredPosts.map((post, index) => <a href={`/blog/${post.id}/`}><span class="featured-index">0{index + 1}</span><div><small>{post.data.tags.slice(0, 3).map((tag) => `#${tag}`).join(' · ')}</small><h3>{post.data.title}</h3><p>{post.data.description}</p></div><b aria-hidden="true">↗</b></a>)}</div></section>}
 <section class="home-notes"><div class="notes-heading"><div><span class="eyebrow">The latest notes</span><h2>最近写下的</h2></div><a href="/blog/">全部文章 ↗</a></div>
 <div class="home-grid">{posts.slice(0,4).map((post,i) => <article><div class="note-meta"><span>{String(i+1).padStart(2,'0')}</span><FormattedDate date={post.data.pubDate}/></div><a class="note-title" href={`/blog/${post.id}/`}><h3>{post.data.title}</h3><p>{post.data.description}</p></a><div class="note-tags">{post.data.tags.map(tag => <a href={getTagPath(tag)}>#{tag}</a>)}</div></article>)}</div>
 </section>
 <section class="topics"><span class="eyebrow">Follow your curiosity</span><h2>沿着一个主题，继续阅读。</h2><div>{tags.map(tag => <a href={getTagPath(tag)}>#{tag} ↗</a>)}</div></section>
</main><Footer/></body></html>
<style>
 .intro{display:grid;grid-template-columns:1.6fr 1fr;gap:7%;align-items:center;padding:5rem 0;border-bottom:1px solid var(--line)}
 .intro h1{font-size:clamp(2.6rem,5vw,4.7rem);margin:1rem 0 1.6rem;line-height:1.4;font-weight:var(--heading-weight)}
 .intro em{color:var(--acid);font-style:normal}
 .intro-copy>p{max-width:32em;color:var(--muted);font-size:.96rem;margin-bottom:2rem}
 .cover{background:var(--surface-2);border:1px solid var(--line);padding:1.6rem;border-radius:var(--radius);min-height:390px;position:relative;overflow:hidden}
 .cover-top,.cover-bottom{display:flex;justify-content:space-between;align-items:center;font-size:.7rem;color:var(--muted)}
 .cover-bottom{border-top:1px solid var(--line);padding-top:1rem}.cover-bottom strong{font-family:var(--display);font-size:1.15rem;color:var(--ink)}
 .cover-art{height:275px;display:grid;place-items:center;position:relative}.cover-art b{font-family:var(--display);font-weight:400;font-size:7rem;color:var(--acid);z-index:1}.cover-art span{position:absolute;width:190px;height:190px;border:1px solid var(--acid);border-radius:50%}.cover-art i{position:absolute;width:135px;height:230px;border:1px solid var(--line);transform:rotate(35deg)}
 .featured{display:grid;grid-template-columns:minmax(220px,.7fr) 1.6fr;gap:clamp(2rem,6vw,6rem);padding:4rem 0;border-bottom:1px solid var(--line)}.featured-heading{position:sticky;top:7rem;align-self:start}.featured-heading h2{margin:0 0 1rem;font-size:clamp(2rem,3.5vw,3.2rem)}.featured-heading p{color:var(--muted);font-size:.85rem}.featured-list{border-top:1px solid var(--line)}.featured-list>a{display:grid;grid-template-columns:3rem 1fr auto;gap:1rem;align-items:center;padding:1.6rem .4rem;border-bottom:1px solid var(--line);text-decoration:none;transition:padding .25s,background .25s}.featured-list>a:hover{padding-inline:1rem;background:var(--surface)}.featured-index{color:var(--acid);font-size:.7rem}.featured-list small{color:var(--muted);font-size:.65rem}.featured-list h3{margin:.35rem 0;font-size:clamp(1.25rem,2vw,1.65rem)}.featured-list p{margin:0;color:var(--muted);font-size:.78rem}.featured-list b{color:var(--acid);font-size:1.2rem}
 .home-notes{padding:4rem 0}.notes-heading{display:flex;align-items:end;justify-content:space-between;margin-bottom:2rem}.notes-heading h2{font-size:2rem;margin:0}.notes-heading>a{font-size:.8rem;text-underline-offset:5px}
 .home-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.home-grid article{padding:1.8rem;border:1px solid var(--line);border-radius:var(--radius);background:var(--surface);transition:transform .25s,border-color .25s;display:flex;flex-direction:column}.home-grid article:hover{transform:translateY(-3px);border-color:var(--acid)}
 .note-meta{display:flex;justify-content:space-between;font-size:.7rem;color:var(--muted)}.note-meta>span{color:var(--acid)}.note-title{text-decoration:none;flex:1}.note-title h3{font-size:1.5rem;margin:1.5rem 0 .8rem}.note-title p{font-size:.85rem;color:var(--muted)}.note-tags{display:flex;flex-wrap:wrap;gap:.75rem;font-size:.7rem;color:var(--cyan)}.note-tags a{text-decoration:none}
 .topics{padding:3rem 0;border-top:1px solid var(--line)}.topics h2{font-size:1.7rem}.topics>div{display:flex;flex-wrap:wrap;gap:.8rem}.topics a{font-size:.85rem;text-decoration:none;padding:.5rem .9rem;border:1px solid var(--line);border-radius:var(--radius)}.topics a:hover{border-color:var(--acid);color:var(--acid)}
 :global([data-theme="paper"]) .home-grid{gap:0 3rem}:global([data-theme="paper"]) .home-grid article{background:transparent;border:0;border-top:1px solid var(--line);padding:1.6rem 0}
 :global([data-theme="studio"]) .cover-art span{border-radius:8px;transform:rotate(-12deg)}:global([data-theme="studio"]) .cover-art i{transform:rotate(12deg)}
 :global([data-theme="orbit"]) .cover{background:radial-gradient(ellipse at 60% 35%,#305876,var(--surface) 70%)}:global([data-theme="orbit"]) .cover-art i{border-radius:50%;animation:orbit-drift 14s linear infinite}
 :global([data-theme="console"]) .home-grid{grid-template-columns:1fr;gap:0}:global([data-theme="console"]) .home-grid article{background:transparent;border:0;border-top:1px dashed var(--line)}:global([data-theme="console"]) .cover-art span{border-radius:0;border-style:dashed}:global([data-theme="console"]) .cover-art i{display:none}
 :global([data-theme="moss"]) .cover{border-radius:120px 120px 24px 24px}:global([data-theme="moss"]) .cover-top{justify-content:center;gap:1rem}:global([data-theme="moss"]) .cover-art span{border-radius:70% 20% 60% 30%;background:var(--surface);transform:rotate(-15deg)}
 @keyframes orbit-drift{to{transform:rotate(395deg)}}
 @media(max-width:700px){.intro{grid-template-columns:1fr;padding:3rem 0;gap:2rem}.cover{min-height:270px}.cover-art{height:200px}.cover-art b{font-size:5rem}.featured{grid-template-columns:1fr;padding:3rem 0}.featured-heading{position:static}.featured-list>a{grid-template-columns:2rem 1fr auto}.home-grid{grid-template-columns:1fr}.notes-heading{gap:1rem}.notes-heading h2{font-size:1.65rem}}
</style>
