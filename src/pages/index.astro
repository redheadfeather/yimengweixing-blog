---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { AUTHOR_BIO, AUTHOR_NAME, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latest = posts.slice(0, 3);
---

<!doctype html>
<html lang="zh-CN">
	<head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
	<body>
		<Header />
		<div class="ticker" aria-hidden="true"><div>
			<span>THINK LOUDER</span><i>✦</i><span>WRITE SLOWER</span><i>✦</i><span>STAY CURIOUS</span><i>✦</i>
			<span>THINK LOUDER</span><i>✦</i><span>WRITE SLOWER</span><i>✦</i><span>STAY CURIOUS</span><i>✦</i>
		</div></div>
		<main>
			<section class="hero">
				<div class="hero-copy reveal">
					<div class="hero-kicker"><span class="eyebrow">Digital garden / 2026</span><span class="system-status"><b></b> ONLINE</span></div>
					<h1 aria-label="在喧闹世界里，留下安静的思考">
						<span class="line line-a" data-ghost="在喧闹世界里">在喧闹世界里</span>
						<span class="line line-b" data-ghost="留下安静的思考">留下<em>安静</em>的思考</span>
					</h1>
					<div class="hero-bottom"><p>{AUTHOR_BIO}</p><a class="button-link" href="/blog">ENTER ARCHIVE <span aria-hidden="true">↗</span></a></div>
				</div>
				<div class="hero-note reveal delay-1" data-tilt aria-label="站点介绍">
					<div class="card-corners" aria-hidden="true"></div>
					<div class="note-top"><span>NODE / 01</span><span>35.6762° N</span></div>
					<div class="orbit" aria-hidden="true"><span class="planet"></span><span class="satellite"></span></div>
					<p>记录技术<br />观察生活<br /><strong>保持好奇</strong></p>
					<small>{AUTHOR_NAME}<br />TRANSMITTING FROM THE WEB</small>
				</div>
			</section>

			<section class="signal reveal" aria-label="创作宣言">
				<span class="signal-index">[ 001 — 003 ]</span><p>把模糊的想法，<br />变成<strong>可以抵达</strong>的文字。</p><div class="signal-mark" aria-hidden="true">✳</div>
			</section>

			<section class="latest reveal delay-1">
				<div class="section-heading"><div><span class="eyebrow">Latest transmissions</span><h2>最近写下的</h2></div><a href="/blog">ALL NOTES ↗</a></div>
				<div class="post-list">
					{latest.map((post, index) => (
						<a class="post-row" href={`/blog/${post.id}/`}>
							<span class="index">0{index + 1}</span>
							<div class="post-title"><h3>{post.data.title}</h3><p>{post.data.description}</p></div>
							<div class="post-meta"><FormattedDate date={post.data.pubDate} /><span>{post.data.tags[0] ?? '随笔'}</span></div>
							<span class="arrow" aria-hidden="true">↗</span>
						</a>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.ticker { overflow: hidden; color: #070807; background: var(--acid); border-bottom: 1px solid var(--acid); font-family: var(--display); font-size: .68rem; letter-spacing: .13em; white-space: nowrap; }
	.ticker div { display: flex; width: max-content; gap: 2.2rem; padding: .45rem 0; animation: ticker 22s linear infinite; }
	.ticker i { font-style: normal; }
	@keyframes ticker { to { transform: translateX(-50%); } }
	.hero { min-height: 760px; display: grid; grid-template-columns: minmax(0, 1fr) 310px; align-items: center; gap: clamp(3rem, 7vw, 8rem); padding: 6rem 0 7.5rem; border-bottom: 1px solid var(--line); }
	.hero-kicker, .note-top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
	.system-status { display: inline-flex; align-items: center; gap: .5rem; color: var(--muted); font: .62rem monospace; letter-spacing: .12em; }
	.system-status b { width: 6px; height: 6px; background: var(--acid); border-radius: 50%; box-shadow: 0 0 12px var(--acid); animation: pulse 1.5s ease infinite; }
	.hero-copy h1 { max-width: 910px; margin: .5rem 0 2.7rem; font-size: clamp(3.7rem, 7.9vw, 7.7rem); line-height: .88; text-transform: uppercase; }
	.hero-copy .line { position: relative; display: block; width: max-content; max-width: 100%; }
	.hero-copy .line-b { margin-top: .18em; margin-left: clamp(0rem, 4vw, 4.5rem); }
	.hero-copy em { position: relative; color: var(--acid); font-family: var(--serif); font-weight: 400; text-shadow: 0 0 36px rgba(200,255,49,.2); }
	.hero-copy .line::after { content: attr(data-ghost); position: absolute; inset: 0; z-index: -1; color: var(--cyan); opacity: 0; transform: translateX(0); clip-path: inset(42% 0 38%); }
	.hero-copy .line:hover::after { opacity: .7; animation: glitch .3s steps(2) infinite; }
	.hero-bottom { display: flex; align-items: end; justify-content: space-between; gap: 2rem; max-width: 820px; }
	.hero-bottom p { max-width: 500px; margin: 0; color: var(--muted); font-size: .92rem; }
	.hero-note { position: relative; min-height: 440px; padding: 1.5rem; background: linear-gradient(145deg, rgba(54,231,255,.08), transparent 45%), var(--surface); border: 1px solid var(--line); box-shadow: 0 25px 80px rgba(0,0,0,.28); transition: transform .18s ease-out, border-color .25s ease, box-shadow .25s ease; transform-style: preserve-3d; }
	.hero-note:hover { border-color: rgba(200,255,49,.55); box-shadow: 0 30px 100px rgba(0,0,0,.45), 0 0 40px rgba(200,255,49,.06); }
	.card-corners::before, .card-corners::after { content: ""; position: absolute; width: 24px; height: 24px; border-color: var(--acid); }
	.card-corners::before { top: -1px; left: -1px; border-top: 2px solid; border-left: 2px solid; }
	.card-corners::after { right: -1px; bottom: -1px; border-right: 2px solid; border-bottom: 2px solid; }
	.note-top { color: var(--muted); font: .58rem monospace; letter-spacing: .08em; }
	.orbit { position: relative; width: 160px; height: 160px; margin: 2.6rem auto 2rem; border: 1px solid var(--line); border-radius: 50%; animation: spin 16s linear infinite; }
	.orbit::before { content: ""; position: absolute; inset: 25px; border: 1px dashed rgba(54,231,255,.35); border-radius: 50%; }
	.planet { position: absolute; top: 50%; left: 50%; width: 20px; height: 20px; background: var(--acid); border-radius: 50%; box-shadow: 0 0 35px rgba(200,255,49,.7); transform: translate(-50%, -50%); }
	.satellite { position: absolute; top: 13px; left: 50%; width: 9px; height: 9px; background: var(--cyan); border-radius: 50%; box-shadow: 0 0 20px var(--cyan); }
	.hero-note p { margin: 0; font-family: var(--display); font-size: 1.55rem; line-height: 1.3; letter-spacing: -.04em; }
	.hero-note strong { color: var(--acid); }
	.hero-note small { position: absolute; right: 1.5rem; bottom: 1.5rem; color: var(--muted); text-align: right; font: .56rem/1.6 monospace; letter-spacing: .08em; }
	.signal { position: relative; display: grid; grid-template-columns: 1fr 2fr .7fr; align-items: center; min-height: 400px; gap: 2rem; border-bottom: 1px solid var(--line); }
	.signal-index { align-self: start; padding-top: 5rem; color: var(--muted); font: .65rem monospace; }
	.signal p { margin: 0; font-family: var(--serif); font-size: clamp(2.3rem, 5vw, 5rem); line-height: 1.15; letter-spacing: -.05em; }
	.signal strong { color: var(--cyan); font-weight: 400; }
	.signal-mark { color: var(--hot); font-size: clamp(5rem, 12vw, 10rem); text-align: right; text-shadow: 0 0 50px rgba(255,77,141,.25); animation: slow-spin 18s linear infinite; }
	.latest { padding: 7rem 0 2rem; }
	.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 3rem; }
	.section-heading .eyebrow { margin-bottom: .75rem; }
	.section-heading h2 { margin: 0; font-size: clamp(2.8rem, 6vw, 5.8rem); text-transform: uppercase; }
	.section-heading > a { color: var(--acid); font: .7rem monospace; letter-spacing: .1em; text-decoration: none; }
	.post-list { border-top: 1px solid var(--line); }
	.post-row { position: relative; display: grid; grid-template-columns: 60px 1fr 180px 40px; align-items: center; gap: 1.5rem; padding: 2.1rem .6rem; overflow: hidden; border-bottom: 1px solid var(--line); text-decoration: none; transition: padding .3s ease, color .3s ease; }
	.post-row::before { content: ""; position: absolute; inset: 0; z-index: -1; background: var(--acid); transform: scaleY(0); transform-origin: bottom; transition: transform .35s cubic-bezier(.2,.8,.2,1); }
	.post-row:hover { padding-right: 1.2rem; padding-left: 1.2rem; color: #090b09; }
	.post-row:hover::before { transform: scaleY(1); }
	.post-row:hover .post-title p, .post-row:hover .post-meta, .post-row:hover .index { color: #202820; }
	.index { color: var(--acid); font: .75rem monospace; }
	.post-title h3 { margin: 0 0 .35rem; font-size: clamp(1.2rem, 2vw, 1.65rem); transition: transform .3s ease; }
	.post-row:hover .post-title h3 { transform: translateX(8px); }
	.post-title p { margin: 0; color: var(--muted); font-size: .82rem; transition: color .3s ease; }
	.post-meta { display: flex; flex-direction: column; color: var(--muted); font: .65rem monospace; transition: color .3s ease; }
	.arrow { font-size: 1.3rem; transition: transform .3s ease; }
	.post-row:hover .arrow { transform: rotate(45deg) scale(1.2); }
	@keyframes pulse { 50% { opacity: .35; transform: scale(.75); } }
	@keyframes spin { to { transform: rotate(360deg); } }
	@keyframes slow-spin { to { transform: rotate(360deg); } }
	@keyframes glitch { 0% { transform: translate(-4px, 1px); } 50% { transform: translate(5px, -1px); } 100% { transform: translate(-2px, 2px); } }
	@media (max-width: 900px) { .hero { grid-template-columns: 1fr; gap: 4rem; padding: 4.5rem 0; } .hero-note { width: min(100%, 430px); min-height: 400px; justify-self: end; } .signal { grid-template-columns: 1fr 3fr; } .signal-mark { position: absolute; right: 0; opacity: .22; } }
	@media (max-width: 650px) { .hero-copy .line { width: auto; } .hero-copy .line-b { margin-left: 0; } .hero-bottom { align-items: stretch; flex-direction: column; } .hero-bottom .button-link { align-self: flex-start; } .signal { grid-template-columns: 1fr; min-height: 360px; padding: 4rem 0; } .signal-index { padding: 0; } .post-row { grid-template-columns: 35px 1fr 25px; gap: .7rem; } .post-meta { display: none; } }
</style>
