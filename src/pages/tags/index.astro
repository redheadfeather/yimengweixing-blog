---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { getTagPath } from '../../utils/tags';

const posts = await getCollection('blog');
const tagCounts = new Map<string, number>();
posts.forEach((post) => post.data.tags.forEach((tag) => tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1)));
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-CN'));
---
<!doctype html>
<html lang="zh-CN">
	<head><BaseHead title={`Tag 图谱 · ${SITE_TITLE}`} description="按 Tag 分类浏览文章" /></head>
	<body><Header /><main>
		<header class="tag-head reveal">
			<span class="eyebrow">Knowledge coordinates</span>
			<p class="serial">INDEX / {String(tags.length).padStart(2, '0')}</p>
			<h1>TAG<br />图谱</h1>
			<p>每个 Tag 都是一条思考路径。选择一个坐标，查看同一主题下的全部文章。</p>
		</header>
		<section class="tag-grid" aria-label="所有 Tag">
			{tags.map(([tag, count], index) => (
				<a href={getTagPath(tag)} style={`--i:${index}`}>
					<span class="index">{String(index + 1).padStart(2, '0')}</span>
					<h2>#{tag}</h2>
					<span class="count">{count} 篇文章</span>
					<span class="arrow" aria-hidden="true">↗</span>
				</a>
			))}
		</section>
		<a class="back" href="/blog/#tags">← 返回文章搜索</a>
	</main><Footer /></body>
</html>
<style>
	.tag-head { position: relative; padding: 6rem 0 4.5rem; }
	.tag-head .serial { position: absolute; top: 6.5rem; right: 0; color: var(--hot); font: .65rem monospace; letter-spacing: .16em; }
	.tag-head h1 { margin: 0 0 2rem; font-size: clamp(5rem, 15vw, 13rem); line-height: .75; }
	.tag-head > p:last-child { max-width: 580px; color: var(--muted); }
	.tag-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
	.tag-grid a { position: relative; display: flex; min-height: 220px; flex-direction: column; justify-content: space-between; padding: 1.5rem; overflow: hidden; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); text-decoration: none; transition: color .25s ease, background .25s ease, transform .25s ease; }
	.tag-grid a::before { content: ""; position: absolute; inset: auto -30% -60% auto; width: 180px; aspect-ratio: 1; background: var(--acid); border-radius: 50%; filter: blur(80px); opacity: 0; transition: opacity .3s ease; }
	.tag-grid a:hover { z-index: 2; color: var(--acid); background: var(--surface); transform: translateY(-6px); }
	.tag-grid a:hover::before { opacity: .2; }
	.index, .count { color: var(--muted); font: .62rem monospace; letter-spacing: .1em; }
	h2 { margin: auto 0; font-size: clamp(1.7rem, 3.5vw, 2.8rem); }
	.arrow { position: absolute; right: 1.5rem; bottom: 1.2rem; color: var(--cyan); font-size: 1.2rem; }
	.back { display: inline-block; margin: 3rem 0 1rem; color: var(--muted); font: .7rem monospace; text-decoration: none; }
	.back:hover { color: var(--acid); }
	@media (max-width: 850px) { .tag-grid { grid-template-columns: repeat(2, 1fr); } }
	@media (max-width: 540px) { .tag-head { padding-top: 4rem; } .tag-grid { grid-template-columns: 1fr; } .tag-grid a { min-height: 170px; } }
</style>
