---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<!doctype html>
<html lang="zh-CN">
	<head><BaseHead title={`文章 · ${SITE_TITLE}`} description="所有文章与随笔" /></head>
	<body><Header /><main>
		<header class="archive-head reveal"><span class="eyebrow">Writing archive</span><h1>所有文章</h1><p>一些不急着得出结论的记录。关于技术、创造，也关于普通生活。</p></header>
		<section class="archive-grid reveal delay-1">
			{posts.map((post, index) => <article>
				<a href={`/blog/${post.id}/`}>
					<div class="card-top"><span>{String(index + 1).padStart(2, '0')}</span><FormattedDate date={post.data.pubDate} /></div>
					<h2>{post.data.title}</h2><p>{post.data.description}</p>
					<div class="tags">{post.data.tags.map(tag => <span>#{tag}</span>)}</div>
				</a>
			</article>)}
		</section>
	</main><Footer /></body>
</html>
<style>
	.archive-head { position: relative; max-width: 900px; padding: 7rem 0 5rem; }
	.archive-head::after { content: "ARCHIVE"; position: absolute; top: 3rem; right: -24vw; z-index: -1; color: transparent; -webkit-text-stroke: 1px var(--line); font-family: var(--display); font-size: clamp(7rem, 18vw, 18rem); line-height: 1; pointer-events: none; animation: breathe 5s ease-in-out infinite alternate; }
	.archive-head h1 { margin: 0 0 1.5rem; color: var(--ink); font-size: clamp(4.2rem, 10vw, 9rem); text-transform: uppercase; }
	.archive-head p { color: var(--muted); font-size: 1.05rem; }
	.archive-grid { display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
	article { position: relative; overflow: hidden; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
	article::before { content: ""; position: absolute; inset: 0; background: linear-gradient(135deg, transparent 35%, rgba(54,231,255,.1)); opacity: 0; transform: scale(1.2); transition: opacity .35s ease, transform .5s ease; }
	article a { position: relative; z-index: 1; display: flex; min-height: 350px; flex-direction: column; padding: 2rem; text-decoration: none; transition: transform .35s ease, background .35s ease; }
	article:hover::before { opacity: 1; transform: scale(1); }
	article:hover a { transform: translateY(-7px); }
	article:nth-child(3n + 1):hover { box-shadow: inset 0 -3px var(--acid); }
	article:nth-child(3n + 2):hover { box-shadow: inset 0 -3px var(--cyan); }
	article:nth-child(3n + 3):hover { box-shadow: inset 0 -3px var(--hot); }
	.card-top { display: flex; justify-content: space-between; color: var(--muted); font: .67rem monospace; letter-spacing: .08em; }
	.card-top span:first-child { color: var(--acid); }
	article h2 { margin: auto 0 1rem; font-size: clamp(1.8rem, 3.5vw, 2.8rem); }
	article p { color: var(--muted); font-size: .84rem; }
	.tags { display: flex; gap: .8rem; color: var(--cyan); font: .67rem monospace; }
	@keyframes breathe { to { opacity: .35; transform: translateX(-2vw); } }
	@media (max-width: 700px) { .archive-head { padding: 4rem 0 3rem; } .archive-grid { grid-template-columns: 1fr; } article a { min-height: 270px; } }
</style>
