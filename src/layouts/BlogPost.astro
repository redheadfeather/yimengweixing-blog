---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { getTagPath } from '../utils/tags';
type RelatedPost = CollectionEntry<'blog'> & { score:number };
type Props = CollectionEntry<'blog'>['data'] & { headings:MarkdownHeading[]; relatedPosts:RelatedPost[] };
const { title,description,pubDate,updatedDate,heroImage,tags,headings,relatedPosts } = Astro.props;
const outline = headings.filter((heading) => heading.depth===2 || heading.depth===3);
---
<html lang="zh-CN"><head><BaseHead title={title} description={description} image={heroImage}/></head>
<body><Header/><div class="reading-progress" aria-hidden="true"><span></span></div><main>
	<a class="back archive-return" href="/blog/">← 返回档案柜</a>
	<article class="article-terminal pixel-shell">
		<div class="terminal-bar"><span>LOG READER / READ ONLY</span><span class="reader-light">● CHANNEL ONLINE</span></div>
		<header class="post-head">
			<div class="post-meta"><span data-pagefind-meta={`date:${pubDate.toISOString().slice(0,10)}`}><FormattedDate date={pubDate}/></span><span>·</span><div class="post-tags" data-pagefind-meta="tags">{tags.map((tag) => <a href={getTagPath(tag)} data-pagefind-filter={`tag:${tag}`}>#{tag}</a>)}</div></div>
			<h1 data-pagefind-meta="title">{title}</h1><p data-pagefind-meta="description">{description}</p>{updatedDate && <small>更新于 <FormattedDate date={updatedDate}/></small>}
		</header>
		{heroImage && <div class="hero-image"><Image width={1120} height={560} src={heroImage} alt=""/></div>}
		<div class="reading-layout">
			{outline.length>0 && <details class="toc" open><summary>读取坐标</summary><nav aria-label="文章目录">{outline.map((heading,index) => <a class:list={[`depth-${heading.depth}`]} href={`#${heading.slug}`}><span>{String(index+1).padStart(2,'0')}</span>{heading.text}</a>)}</nav></details>}
			<div class="prose" id="article-content" data-pagefind-body><slot/></div>
		</div>
	</article>
	{relatedPosts.length>0 && <section class="related pixel-shell" aria-labelledby="related-title"><div><span class="eyebrow">NEXT CARTRIDGES</span><h2 id="related-title">继续读取相邻信号</h2></div><div class="related-grid">{relatedPosts.map((post) => <a href={`/blog/${post.id}/`}><span>{post.data.tags.slice(0,2).map((tag)=>`#${tag}`).join(' · ')}</span><strong>{post.data.title}</strong><small>{post.data.description}</small></a>)}</div></section>}
</main><Footer/><button class="back-top" type="button" aria-label="返回顶部" title="返回顶部">↑</button></body></html>
<script>
	const progress=document.querySelector<HTMLElement>('.reading-progress span');const backTop=document.querySelector<HTMLButtonElement>('.back-top');const toc=document.querySelector<HTMLDetailsElement>('.toc');if(toc&&matchMedia('(max-width: 900px)').matches)toc.open=false;const tocLinks=[...document.querySelectorAll<HTMLAnchorElement>('.toc a')];const headings=tocLinks.map((link)=>document.getElementById(decodeURIComponent(link.hash.slice(1)))).filter(Boolean) as HTMLElement[];
	const back=document.querySelector<HTMLAnchorElement>('.archive-return');try{const saved=sessionStorage.getItem('pixel-lab-archive-return');if(back&&saved?.startsWith('/blog'))back.href=saved}catch{}
	const update=()=>{const max=document.documentElement.scrollHeight-innerHeight,ratio=max>0?Math.min(scrollY/max,1):0;progress?.style.setProperty('transform',`scaleX(${ratio})`);backTop?.classList.toggle('visible',scrollY>520);let active=headings[0]?.id;for(const heading of headings)if(heading.getBoundingClientRect().top<=150)active=heading.id;tocLinks.forEach((link)=>link.classList.toggle('active',decodeURIComponent(link.hash.slice(1))===active))};addEventListener('scroll',update,{passive:true});update();backTop?.addEventListener('click',()=>scrollTo({top:0,behavior:'smooth'}));
	document.querySelectorAll<HTMLElement>('#article-content pre').forEach((pre)=>{const code=pre.querySelector('code');if(!code||pre.parentElement?.classList.contains('code-frame'))return;const language=[...code.classList].find((name)=>name.startsWith('language-'))?.replace('language-','')||'CODE';const frame=document.createElement('div');frame.className='code-frame';const bar=document.createElement('div');bar.className='code-bar';const label=document.createElement('span');label.textContent=language;const button=document.createElement('button');button.type='button';button.textContent='COPY';button.setAttribute('aria-label',`复制${language}代码`);bar.append(label,button);pre.before(frame);frame.append(bar,pre);button.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(code.textContent??'');button.textContent='COPIED'}catch{button.textContent='FAILED'}dispatchEvent(new Event('pixel-lab:copy'));setTimeout(()=>button.textContent='COPY',1600)})});
</script>
<style>
.archive-return{margin:3rem 0 1.5rem;color:#e2b99e}.article-terminal{overflow:visible}.terminal-bar{display:flex;justify-content:space-between;gap:1rem;padding:.7rem 1rem;color:#ffbc79;background:#2a1713;border-bottom:4px solid #623729;font-family:var(--display);font-size:.58rem}.reader-light{color:var(--cyan)}.post-head{padding:clamp(2.5rem,6vw,5rem);padding-bottom:3rem;background:linear-gradient(135deg,#f3dfb8,#dcb886)}.post-meta{display:flex;flex-wrap:wrap;gap:.65rem;margin-bottom:1.2rem;color:var(--hot);font-family:var(--display);font-size:.62rem}.post-tags{display:flex;flex-wrap:wrap;gap:.35rem .7rem}.post-tags a{color:#177c76;text-decoration:none}.post-head h1{max-width:900px;font-family:var(--sans);font-weight:800;margin:0 0 1.2rem;font-size:clamp(2.2rem,6vw,4.8rem)}.post-head>p{max-width:720px;color:#65402f;font-size:1.06rem}.post-head small{color:var(--muted)}.hero-image{max-width:1050px;margin:2rem auto 0;border:4px solid var(--line);box-shadow:8px 8px #72432f}.hero-image :global(img){display:block;width:100%}
.reading-layout{display:grid;min-width:0;grid-template-columns:minmax(170px,220px) minmax(0,760px);justify-content:center;gap:clamp(2rem,5vw,5rem);align-items:start;padding:clamp(2rem,5vw,4rem)}.reading-layout:has(.prose:only-child){display:block}.toc{position:sticky;top:100px;max-height:calc(100vh - 120px);overflow:auto;padding:1rem;background:#e4c495;border:4px solid var(--line);box-shadow:6px 6px #744631}.toc summary{margin:0;color:var(--hot);font-family:var(--display);font-size:.75rem;cursor:pointer;list-style:none}.toc summary::-webkit-details-marker{display:none}.toc summary::after{content:" / OPEN";color:var(--muted);font-size:.5rem}.toc[open] summary{margin-bottom:.7rem}.toc[open] summary::after{content:" / CLOSE"}.toc:not([open]) nav{display:none}.toc nav{display:grid}.toc a{display:grid;grid-template-columns:1.7rem 1fr;gap:.4rem;padding:.45rem;color:#694031;border-left:4px solid transparent;font-size:.7rem;line-height:1.45;text-decoration:none}.toc a span{color:var(--hot);font-family:var(--display);font-size:.52rem}.toc a.depth-3{padding-left:1.1rem}.toc a:hover,.toc a.active{color:var(--hot);background:#f7ddb0;border-color:var(--acid)}
.reading-progress{position:fixed;z-index:100;top:0;left:0;width:100%;height:5px;pointer-events:none}.reading-progress span{display:block;width:100%;height:100%;background:linear-gradient(90deg,var(--acid),var(--yellow));box-shadow:0 0 12px #ff6d3b;transform:scaleX(0);transform-origin:left}.related{margin:4rem 0 2rem;padding:2.2rem}.related h2{font-size:clamp(1.6rem,3vw,2.5rem)}.related-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.related-grid a{display:flex;min-height:190px;flex-direction:column;padding:1.2rem;color:var(--ink);background:var(--paper);border:4px solid var(--line);box-shadow:inset -5px -5px #d0a472,6px 6px #75422f;text-decoration:none;transition:.18s}.related-grid a:hover{transform:translateY(-5px)}.related-grid span{color:var(--hot);font-family:var(--display);font-size:.55rem}.related-grid strong{margin:auto 0 .6rem;font-family:var(--display);font-weight:400;line-height:1.45}.related-grid small{color:var(--muted);line-height:1.6}.back-top{position:fixed;right:clamp(1rem,3vw,2.5rem);bottom:1.5rem;z-index:50;display:grid;place-items:center;width:44px;height:44px;color:var(--paper);background:var(--acid);border:4px solid #6f2017;box-shadow:5px 5px #31130e;cursor:pointer;opacity:0;transform:translateY(12px);pointer-events:none;transition:.2s}.back-top.visible{opacity:1;transform:none;pointer-events:auto}:global(.related-grid strong){font-family:var(--sans);font-weight:700}:global(.code-frame){max-width:100%;min-width:0;margin:2rem 0;overflow:hidden;border:4px solid #6f3527;background:#20110f}:global(.code-frame pre){max-width:100%;margin:0;overflow-x:auto;overscroll-behavior-inline:contain;border:0}:global(.code-bar){display:flex;align-items:center;justify-content:space-between;padding:.55rem .8rem;color:#ff9b62;background:#3b1d17;border-bottom:3px solid #6f3527;font-family:var(--display);font-size:.58rem}:global(.code-bar button){padding:.3rem .6rem;color:#fff4d2;background:var(--acid);border:2px solid #8b2c1d;cursor:pointer;font:inherit}
@media(max-width:900px){.reading-layout{display:block}.toc{position:static;max-height:none;margin-bottom:2rem}.toc nav{grid-template-columns:repeat(2,1fr)}}@media(max-width:700px){.archive-return{margin-top:2rem}.terminal-bar span:last-child{display:none}.post-head{padding:2rem 1.3rem}.reading-layout{padding:1.5rem 1.1rem}.toc nav{grid-template-columns:1fr}.related-grid{grid-template-columns:1fr}.related{padding:1.4rem}}

</style>
