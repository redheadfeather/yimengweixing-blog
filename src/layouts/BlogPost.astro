---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
type Props = CollectionEntry<'blog'>['data'];
const { title, description, pubDate, updatedDate, heroImage, tags } = Astro.props;
---
<html lang="zh-CN">
	<head><BaseHead title={title} description={description} image={heroImage} /></head>
	<body><Header /><main><article>
		<header class="post-head reveal">
			<a class="back" href="/blog">← 返回文章</a>
			<div class="post-meta"><FormattedDate date={pubDate} /><span>·</span><span>{tags.join(' / ')}</span></div>
			<h1>{title}</h1><p>{description}</p>
			{updatedDate && <small>更新于 <FormattedDate date={updatedDate} /></small>}
		</header>
		{heroImage && <div class="hero-image"><Image width={1120} height={560} src={heroImage} alt="" /></div>}
		<div class="prose"><slot /></div>
	</article></main><Footer /></body>
</html>
<style>
	.post-head { position: relative; width: min(950px, 100%); padding: 5.5rem 0 4rem; }
	.post-head::after { content: "READ / FOCUS / THINK"; position: absolute; right: 0; bottom: 1rem; color: var(--line); font: .6rem monospace; letter-spacing: .2em; writing-mode: vertical-rl; }
	.back { display: inline-block; margin-bottom: 4rem; color: var(--muted); font: .7rem monospace; letter-spacing: .08em; text-decoration: none; transition: color .2s ease, transform .2s ease; }
	.back:hover { color: var(--acid); transform: translateX(-5px); }
	.post-meta { display: flex; gap: .65rem; margin-bottom: 1.5rem; color: var(--acid); font: .7rem monospace; letter-spacing: .08em; }
	.post-head h1 { margin: 0 0 1.5rem; font-size: clamp(3.4rem, 8vw, 7rem); text-wrap: balance; }
	.post-head > p { max-width: 650px; color: var(--muted); font-family: var(--serif); font-size: 1.2rem; }
	.post-head small { color: var(--muted); font-size: .7rem; }
	.hero-image { margin-bottom: 4rem; overflow: hidden; border: 1px solid var(--line); }
	.hero-image :global(img) { display: block; width: 100%; }
	.prose { padding-bottom: 3rem; }
	@media (max-width: 700px) { .post-head { padding-top: 3rem; } .back { margin-bottom: 2.5rem; } }
</style>
