---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { getTagPath } from '../utils/tags';
type RelatedPost = CollectionEntry<'blog'> & { score: number };
type Props = CollectionEntry<'blog'>['data'] & { headings: MarkdownHeading[]; relatedPosts: RelatedPost[] };
const { title, description, pubDate, updatedDate, heroImage, tags, headings, relatedPosts } = Astro.props;
const outline = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---
<html lang="zh-CN">
	<head><BaseHead title={title} description={description} image={heroImage} /></head>
	<body><Header /><div class="reading-progress" aria-hidden="true"><span></span></div><main><article>
		<header class="post-head reveal">
			<a class="back" href="/blog">← 返回文章</a>
			<div class="post-meta">
				<FormattedDate date={pubDate} /><span>·</span>
				<div class="post-tags">{tags.map((tag) => <a href={getTagPath(tag)}>#{tag}</a>)}</div>
			</div>
			<h1>{title}</h1><p>{description}</p>
			{updatedDate && <small>更新于 <FormattedDate date={updatedDate} /></small>}
		</header>
		{heroImage && <div class="hero-image"><Image width={1120} height={560} src={heroImage} alt="" /></div>}
		<div class="reading-layout">
			{outline.length > 0 && <aside class="toc" aria-label="文章目录">
				<p>这篇文章</p><nav>{outline.map((heading) => <a class:list={[`depth-${heading.depth}`]} href={`#${heading.slug}`}>{heading.text}</a>)}</nav>
			</aside>}
			<div class="prose" id="article-content"><slot /></div>
		</div>
		{relatedPosts.length > 0 && <section class="related" aria-labelledby="related-title">
			<div><span class="eyebrow">继续阅读</span><h2 id="related-title">沿着相同的线索</h2></div>
			<div class="related-grid">{relatedPosts.map((post) => <a href={`/blog/${post.id}/`}><span>{post.data.tags.slice(0, 2).map((tag) => `#${tag}`).join(' · ')}</span><strong>{post.data.title}</strong><small>{post.data.description}</small></a>)}</div>
		</section>}
	</article></main><Footer /><button class="back-top" type="button" aria-label="返回顶部" title="返回顶部">↑</button></body>
</html>
<script>
	const progress = document.querySelector<HTMLElement>('.reading-progress span');
	const backTop = document.querySelector<HTMLButtonElement>('.back-top');
	const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
	const headings = tocLinks.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1)))).filter(Boolean) as HTMLElement[];
	const updateReadingState = () => {
		const max = document.documentElement.scrollHeight - innerHeight;
		const ratio = max > 0 ? Math.min(scrollY / max, 1) : 0;
		progress?.style.setProperty('transform', `scaleX(${ratio})`);
		backTop?.classList.toggle('visible', scrollY > 520);
		let active = headings[0]?.id;
		for (const heading of headings) if (heading.getBoundingClientRect().top <= 150) active = heading.id;
		tocLinks.forEach((link) => link.classList.toggle('active', decodeURIComponent(link.hash.slice(1)) === active));
	};
	addEventListener('scroll', updateReadingState, { passive: true });
	updateReadingState();
	backTop?.addEventListener('click', () => scrollTo({ top: 0, behavior: 'smooth' }));

	document.querySelectorAll<HTMLElement>('#article-content pre').forEach((pre) => {
		const code = pre.querySelector('code');
		if (!code || pre.parentElement?.classList.contains('code-frame')) return;
		const language = [...code.classList].find((name) => name.startsWith('language-'))?.replace('language-', '') || '代码';
		const frame = document.createElement('div'); frame.className = 'code-frame';
		const bar = document.createElement('div'); bar.className = 'code-bar';
		const label = document.createElement('span'); label.textContent = language;
		const button = document.createElement('button'); button.type = 'button'; button.textContent = '复制'; button.setAttribute('aria-label', `复制${language}代码`);
		bar.append(label, button); pre.before(frame); frame.append(bar, pre);
		button.addEventListener('click', async () => {
			try { await navigator.clipboard.writeText(code.textContent ?? ''); button.textContent = '已复制'; }
			catch { button.textContent = '复制失败'; }
			setTimeout(() => button.textContent = '复制', 1600);
		});
	});
</script>
<style>
	.post-head { position: relative; width: min(950px, 100%); padding: 5.5rem 0 4rem; }
	.post-head::after { content: "READ / FOCUS / THINK"; position: absolute; right: 0; bottom: 1rem; color: var(--line); font: .6rem monospace; letter-spacing: .2em; writing-mode: vertical-rl; }
	.back { display: inline-block; margin-bottom: 4rem; color: var(--muted); font: .7rem monospace; letter-spacing: .08em; text-decoration: none; transition: color .2s ease, transform .2s ease; }
	.back:hover { color: var(--acid); transform: translateX(-5px); }
	.post-meta { display: flex; gap: .65rem; margin-bottom: 1.5rem; color: var(--acid); font: .7rem monospace; letter-spacing: .08em; }
	.post-tags { display: flex; flex-wrap: wrap; gap: .4rem .75rem; }
	.post-tags a { color: var(--cyan); text-decoration: none; transition: color .2s ease; }
	.post-tags a:hover { color: var(--acid); text-decoration: underline; text-underline-offset: 4px; }
	.post-head h1 { margin: 0 0 1.5rem; font-size: clamp(3.4rem, 8vw, 7rem); text-wrap: balance; }
	.post-head > p { max-width: 650px; color: var(--muted); font-family: var(--serif); font-size: 1.2rem; }
	.post-head small { color: var(--muted); font-size: .7rem; }
	.hero-image { margin-bottom: 4rem; overflow: hidden; border: 1px solid var(--line); }
	.hero-image :global(img) { display: block; width: 100%; }
	.reading-progress { position: fixed; z-index: 100; top: 0; left: 0; width: 100%; height: 3px; pointer-events: none; }
	.reading-progress span { display: block; width: 100%; height: 100%; background: var(--acid); transform: scaleX(0); transform-origin: left; }
	.reading-layout { display: grid; grid-template-columns: minmax(160px, 220px) minmax(0, 740px); justify-content: center; gap: clamp(2rem, 6vw, 6rem); align-items: start; }
	.reading-layout:has(.prose:only-child) { display: block; }
	.toc { position: sticky; top: 7rem; max-height: calc(100vh - 9rem); overflow: auto; padding: 1rem 0 1rem 1rem; border-left: 1px solid var(--line); }
	.toc p { margin: 0 0 .8rem; color: var(--ink); font-size: .72rem; font-weight: 700; }
	.toc nav { display: grid; gap: .15rem; }
	.toc a { padding: .35rem .55rem; color: var(--muted); font-size: .7rem; line-height: 1.45; text-decoration: none; border-radius: calc(var(--radius) / 2); transition: color .2s, background .2s; }
	.toc a.depth-3 { padding-left: 1.25rem; font-size: .65rem; }
	.toc a:hover, .toc a.active { color: var(--acid); background: color-mix(in srgb, var(--acid) 8%, transparent); }
	.prose { width: 100%; margin: 0; padding-bottom: 3rem; }
	:global(.code-frame) { margin: 2rem 0; overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius); background: #101312; }
	:global(.code-frame pre) { margin: 0; border: 0 !important; border-radius: 0 !important; }
	:global(.code-bar) { display: flex; align-items: center; justify-content: space-between; padding: .55rem .8rem; color: #aab3ad; background: #191d1b; border-bottom: 1px solid #323936; font: .68rem ui-monospace, monospace; }
	:global(.code-bar span) { text-transform: uppercase; letter-spacing: .08em; }
	:global(.code-bar button) { padding: .25rem .55rem; color: #d8dfda; background: transparent; border: 1px solid #46504b; border-radius: 4px; cursor: pointer; font: inherit; }
	:global(.code-bar button:hover) { color: #fff; border-color: #8f9d96; }
	.back-top { position: fixed; right: clamp(1rem, 3vw, 2.5rem); bottom: 1.5rem; z-index: 50; display: grid; place-items: center; width: 42px; height: 42px; color: var(--on-accent); background: var(--acid); border: 0; border-radius: var(--radius); cursor: pointer; opacity: 0; transform: translateY(12px); pointer-events: none; transition: opacity .2s, transform .2s; }
	.back-top.visible { opacity: 1; transform: none; pointer-events: auto; }
	.related { margin: 4rem 0 2rem; padding-top: 3rem; border-top: 1px solid var(--line); }
	.related h2 { margin: 0 0 1.5rem; font-size: clamp(1.8rem, 3vw, 2.5rem); }
	.related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
	.related-grid a { display: flex; min-height: 190px; flex-direction: column; padding: 1.25rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); text-decoration: none; transition: transform .2s, border-color .2s; }
	.related-grid a:hover { transform: translateY(-3px); border-color: var(--acid); }
	.related-grid span { color: var(--acid); font-size: .65rem; }
	.related-grid strong { margin: auto 0 .7rem; font-family: var(--display); font-size: 1.1rem; line-height: 1.45; }
	.related-grid small { color: var(--muted); font-size: .72rem; line-height: 1.65; }
	@media (max-width: 900px) { .reading-layout { display: block; } .toc { position: static; max-height: none; margin-bottom: 2rem; padding: 1rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); } .toc nav { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	@media (max-width: 700px) { .post-head { padding-top: 3rem; } .back { margin-bottom: 2.5rem; } .toc nav { grid-template-columns: 1fr; } .related-grid { grid-template-columns: 1fr; } .related-grid a { min-height: 150px; } }
</style>
