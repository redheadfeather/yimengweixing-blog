---
import { AUTHOR_GITHUB, AUTHOR_NAME, SITE_TITLE } from '../consts';
import MotionEffects from './MotionEffects.astro';
const today = new Date();
---
<MotionEffects />
<footer>
	<div class="footer-inner pixel-shell">
		<div><span class="signal"></span><p class="footer-title">实验未结束，记录仍在写入。</p></div>
		<div class="footer-meta"><span>© {today.getFullYear()} {AUTHOR_NAME}</span><span><a href={AUTHOR_GITHUB} target="_blank" rel="noreferrer">CODE REPOSITORY ↗</a> · {SITE_TITLE} · ASTRO UNIT</span></div>
	</div>
</footer>
<style>
footer{margin-top:6rem;padding:0 12px 2.5rem}.footer-inner{width:min(1120px,100%);margin:auto;padding:2rem 2.2rem;background:#dcbc8e}.signal{display:inline-block;width:8px;height:8px;margin-right:.5rem;background:var(--cyan);box-shadow:0 0 12px var(--cyan)}.footer-title{display:inline;color:var(--hot);font-family:var(--display);font-size:clamp(1rem,2.4vw,1.6rem)}.footer-meta{display:flex;justify-content:space-between;gap:1rem;margin-top:2.5rem;padding-top:1rem;color:#6b3b2c;border-top:3px dashed #8e664a;font-size:.72rem}.footer-meta a{color:var(--hot);text-decoration:none}
@media(max-width:620px){.footer-meta{flex-direction:column}.footer-inner{padding:1.5rem}}

</style>
