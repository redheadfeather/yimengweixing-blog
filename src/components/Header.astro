---
import { AUTHOR_GITHUB, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---
<header class="site-header">
	<nav aria-label="主导航">
		<a class="brand" href="/" aria-label={`${SITE_TITLE}首页`}><span class="led"></span><strong>{SITE_TITLE}</strong><small>// LAB-08</small></a>
		<div class="nav-links">
			<HeaderLink href="/">实验室</HeaderLink>
			<HeaderLink href="/blog">档案库</HeaderLink>
			<HeaderLink href="/tags">信号索引</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
			<a class="desktop-link" href={AUTHOR_GITHUB} target="_blank" rel="noreferrer">CODE ↗</a>
			<a class="desktop-link" href="/rss.xml">RSS</a>
		</div>
		<div class="lab-controls">
			<button id="sound-toggle" type="button" aria-label="开启音效" title="声音">♪</button>
			<button id="motion-toggle" class="active" type="button" aria-label="关闭动效" title="动效">✦</button>
		</div>
	</nav>
</header>
<style>
.site-header{position:sticky;z-index:40;top:10px;width:min(1180px,calc(100% - 24px));margin:10px auto 0;color:var(--ink);background:rgba(241,223,189,.95);border:4px solid var(--line);box-shadow:0 5px #130b09,0 9px 26px #0008;backdrop-filter:blur(12px)}
nav{min-height:58px;padding:.5rem .75rem;display:flex;align-items:center;gap:1rem}.brand{display:flex;align-items:center;gap:.65rem;margin-right:auto;font-family:var(--display);text-decoration:none;letter-spacing:.06em}.brand strong{font-weight:400}.brand small{font-size:.55rem;color:var(--muted)}.led{width:11px;height:11px;background:var(--acid);box-shadow:0 0 0 3px #5a2318,0 0 13px 4px #ff5b2f;animation:lab-blink 1.2s steps(2) infinite}.nav-links{display:flex;align-items:center;gap:.35rem}.nav-links :global(a){position:relative;padding:.55rem .65rem;color:#603526;text-decoration:none;font-family:var(--display);font-size:.66rem}.nav-links :global(a:hover),.nav-links :global(a.active){color:var(--paper);background:var(--hot);box-shadow:inset -3px -3px #7d2117,inset 3px 3px #f47a52}.lab-controls{display:flex;gap:.35rem}.lab-controls button{display:grid;place-items:center;width:36px;height:36px;padding:0;color:var(--ink);background:#dfbd8d;border:3px solid #51271e;box-shadow:inset -3px -3px #ad8057,inset 3px 3px #fff1cd;cursor:pointer}.lab-controls button:hover,.lab-controls button.active{color:var(--paper);background:var(--acid);transform:translateY(-2px)}
@media(max-width:820px){.site-header{top:0;width:100%;margin:0;border-width:0 0 4px}.desktop-link,.brand small{display:none}.nav-links{gap:0}.nav-links :global(a){padding:.5rem .38rem;font-size:.58rem}.brand strong{display:none}nav{gap:.35rem}.lab-controls{margin-left:auto}}

</style>
