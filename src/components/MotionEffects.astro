<canvas id="motion-background" aria-hidden="true"></canvas>
<div class="motion-grain" aria-hidden="true"></div>
<div class="lab-toast" id="lab-toast" role="status" aria-live="polite"></div>
<script is:inline>
(() => {
	const canvas = document.getElementById('motion-background');
	if (!(canvas instanceof HTMLCanvasElement)) return;
	const context = canvas.getContext('2d');
	if (!context) return;
	const root = document.documentElement;
	const soundButton = document.getElementById('sound-toggle');
	const motionButton = document.getElementById('motion-toggle');
	const toast = document.getElementById('lab-toast');
	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const coarse = matchMedia('(pointer: coarse)').matches;
	let soundOn = false;
	let motionOn = !reduceMotion;
	try { soundOn = localStorage.getItem('pixel-lab-sound') === 'on'; motionOn = localStorage.getItem('pixel-lab-motion') !== 'off' && !reduceMotion; } catch {}
	let audioContext;
	const beep = (type = 'click') => {
		if (!soundOn) return;
		audioContext ??= new (window.AudioContext || window.webkitAudioContext)();
		if (audioContext.state === 'suspended') audioContext.resume();
		const map = { hover:[560,.035,'square'], click:[240,.08,'square'], search:[740,.11,'triangle'], copy:[420,.14,'square'], nav:[190,.13,'sawtooth'] };
		const [frequency,duration,wave] = map[type] || map.click;
		const oscillator = audioContext.createOscillator();
		const gain = audioContext.createGain();
		oscillator.type = wave;
		oscillator.frequency.setValueAtTime(frequency, audioContext.currentTime);
		if (type === 'nav') oscillator.frequency.exponentialRampToValueAtTime(frequency * 2.2, audioContext.currentTime + duration);
		gain.gain.setValueAtTime(.035, audioContext.currentTime);
		gain.gain.exponentialRampToValueAtTime(.001, audioContext.currentTime + duration);
		oscillator.connect(gain).connect(audioContext.destination);
		oscillator.start(); oscillator.stop(audioContext.currentTime + duration);
	};
	window.pixelLabBeep = beep;
	const notify = (message) => {
		if (!toast) return;
		toast.textContent = message; toast.classList.add('show');
		setTimeout(() => toast.classList.remove('show'), 1200);
	};
	const syncControls = () => {
		soundButton?.classList.toggle('active', soundOn);
		motionButton?.classList.toggle('active', motionOn);
		soundButton?.setAttribute('aria-label', soundOn ? '关闭音效' : '开启音效');
		motionButton?.setAttribute('aria-label', motionOn ? '关闭动效' : '开启动效');
		root.dataset.motion = motionOn ? 'on' : 'off';
	};
	soundButton?.addEventListener('click', () => {
		soundOn = !soundOn;
		try { localStorage.setItem('pixel-lab-sound', soundOn ? 'on' : 'off'); } catch {}
		syncControls(); if (soundOn) beep('search'); notify(soundOn ? 'SOUND // ONLINE' : 'SOUND // MUTED');
	});
	motionButton?.addEventListener('click', () => {
		motionOn = !motionOn;
		try { localStorage.setItem('pixel-lab-motion', motionOn ? 'on' : 'off'); } catch {}
		syncControls(); beep(); notify(motionOn ? 'VISUAL FX // ONLINE' : 'VISUAL FX // PAUSED');
	});
	document.addEventListener('pointerover', (event) => {
		const element = event.target.closest('button, a, article');
		if (!element || element.dataset.sounded) return;
		element.dataset.sounded = '1'; beep('hover'); setTimeout(() => delete element.dataset.sounded, 220);
	});
	document.addEventListener('click', (event) => {
		const link = event.target.closest('a');
		if (link && link.origin === location.origin) beep('nav');
	});
	addEventListener('pixel-lab:search', () => beep('search'));
	addEventListener('pixel-lab:copy', () => beep('copy'));
	syncControls();
	document.querySelectorAll('.reveal').forEach((element) => {
		if (reduceMotion) { element.classList.add('in-view'); return; }
		new IntersectionObserver(([entry], observer) => {
			if (entry.isIntersecting) { entry.target.classList.add('in-view'); observer.disconnect(); }
		}, { threshold:.1 }).observe(element);
	});
	let width = innerWidth, height = innerHeight, frame = 0;
	const pointer = { x:.72, y:.28 }, target = { x:.72, y:.28, active:false };
	const particles = Array.from({ length:coarse ? 24 : 52 }, () => ({ x:Math.random(), y:Math.random(), size:Math.random()*3+1, speed:Math.random()*.00042+.00013, tone:Math.random()>.78 }));
	const resize = () => {
		const dpr = Math.min(devicePixelRatio || 1, 1.5); width = innerWidth; height = innerHeight;
		canvas.width = Math.round(width*dpr); canvas.height = Math.round(height*dpr); canvas.style.width = width+'px'; canvas.style.height = height+'px'; context.setTransform(dpr,0,0,dpr,0,0);
	};
	const move = (event) => {
		target.x = event.clientX / width; target.y = event.clientY / height; target.active = true;
		if (!motionOn) return;
		root.style.setProperty('--lab-hero-x', ((.5-target.x)*30)+'px');
		root.style.setProperty('--lab-hero-y', ((.5-target.y)*18)+'px');
		root.style.setProperty('--lab-copy-x', ((target.x-.5)*14)+'px');
		root.style.setProperty('--lab-copy-y', ((target.y-.5)*10)+'px');
	};
	const draw = () => {
		context.clearRect(0,0,width,height);
		if (motionOn && !document.hidden) {
			if (coarse && !target.active) { target.x=.5+Math.sin(performance.now()*.00035)*.28; target.y=.38+Math.cos(performance.now()*.00027)*.17; }
			pointer.x += (target.x-pointer.x)*.06; pointer.y += (target.y-pointer.y)*.06;
			const glow = context.createRadialGradient(pointer.x*width,pointer.y*height,0,pointer.x*width,pointer.y*height,260);
			glow.addColorStop(0,'rgba(237,89,45,.13)'); glow.addColorStop(1,'rgba(237,89,45,0)'); context.fillStyle=glow; context.fillRect(0,0,width,height);
			particles.forEach((particle) => {
				particle.y -= particle.speed; if (particle.y < -.03) { particle.y=1.03; particle.x=Math.random(); }
				let x=particle.x*width, y=particle.y*height; const dx=x-pointer.x*width, dy=y-pointer.y*height, distance=Math.hypot(dx,dy)||1;
				if (!coarse && target.active && distance<115) { const force=(115-distance)*.22; x+=dx/distance*force; y+=dy/distance*force; }
				context.globalAlpha=.25+particle.size*.09; context.fillStyle=particle.tone?'#2eb8ad':'#ed592d';
				const size=Math.max(3,Math.round(particle.size)*3); context.fillRect(Math.round(x/4)*4,Math.round(y/4)*4,size,size);
			});
			context.globalAlpha=1;
		}
		frame=requestAnimationFrame(draw);
	};
	addEventListener('resize', resize, { passive:true });
	if (!reduceMotion) addEventListener('pointermove', move, { passive:true });
	document.addEventListener('visibilitychange', () => { if (document.hidden) cancelAnimationFrame(frame); else frame=requestAnimationFrame(draw); });
	resize(); frame=requestAnimationFrame(draw);
})();
</script>
<style>
#motion-background,.motion-grain{position:fixed;inset:0;z-index:1;width:100%;height:100%;pointer-events:none}#motion-background{image-rendering:pixelated}.motion-grain{z-index:3;opacity:.04;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.82' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter id='n'/%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.5'/%3E%3C/svg%3E");mix-blend-mode:overlay}.lab-toast{position:fixed;left:50%;bottom:28px;z-index:80;padding:.65rem 1rem;color:#ffd3a5;background:#2a1713;border:3px solid #ff6838;font-family:var(--display);font-size:.68rem;opacity:0;transform:translate(-50%,24px);transition:.2s;pointer-events:none}.lab-toast.show{opacity:1;transform:translate(-50%,0)}:global(html[data-motion='off']) #motion-background{display:none}@media(prefers-reduced-motion:reduce){#motion-background{display:none}}
</style>

</style>
